.env
# The file is deleted; this rule is kept deliberately as a safety net, so that
# recreating it with a key in it can never end up committed.
llm.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
chroma_db/
cache/
.DS_Store

# Generated ingest artifacts. Rebuild with: python -m src.cli ingest
# data/sources.md is hand-maintained and stays tracked.
data/documents/
data/index_manifest.json

# Generated by scripts/dump_index.py -- regenerable, ~150KB
data/index_dump.txt

# Local safety net from the AUM/manager data fix. A pre-fix copy of
# data/documents + index_manifest, so it holds the KNOWN-WRONG figures
# (AMC-level AUM, stale fund managers). Nothing should read it, and committing
# it would put wrong data in the repo where a reviewer could mistake it for
# real output. Everything in it is regenerable with: python -m src.cli ingest
backup_before_aum_fix/

