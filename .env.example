# --- Answer layer ------------------------------------------------------------
# This is the ONLY env file. An earlier revision kept credentials in a separate
# llm.env; it is gone, so there is one place to look and no override ordering to
# reason about.
#
# LLM_PROVIDER is groq (default) or anthropic.
LLM_PROVIDER=groq

# temperature is pinned to 0 and max_tokens to 300 in code (A10 determinism);
# only the model is configurable. VERIFY IT: run
#     .venv/bin/python scripts/list_models.py
# which prints the ids your key can actually reach. Do not trust this default --
# it is a placeholder, and an unavailable id fails at the API with a 404 that
# reads like a key problem. GROQ_MODEL wins only if LLM_MODEL is unset.
GROQ_MODEL=qwen/qwen3.8-27b

GROQ_BASE_URL=https://api.groq.com/openai/v1

# REQUIRED for answers. Without it the app still ingests, retrieves and refuses
# cleanly -- every answer is "not found".
# Get one at https://console.groq.com/keys
# Leave quotes off, keep it on one line, and do not leave a placeholder such as
# gsk_YOUR_KEY: the guard only checks the string is non-empty, so a placeholder
# passes it and then fails at the API with a far less obvious error.
GROQ_API_KEY=

# Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Where the Chroma index lives. Leave this UNSET so src/config.py anchors it to
# the project root. A relative value like "./chroma_db" is resolved against the
# process working directory, which is NOT the project root under Render -- the
# index would be written to a path the app never reads, and the UI would
# permanently claim "index not built". To override, use an absolute path.
# CHROMA_DIR=/opt/render/project/src/chroma_db
COLLECTION_NAME=hdfc_mf_faq
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=4

# --- Phase 3 answerability gate ---------------------------------------------
# TWO gates, both required. See docs/architecture.md section 5.6.
#
# MIN_SIMILARITY alone CANNOT separate the eval sets on this corpus: the
# unanswerable "HDFC Bank's FD interest rate?" scores 0.561, above the
# answerable "minimum SIP amount" at 0.445. Keep it as a loose floor.
MIN_SIMILARITY=0.30

# The gate that actually separates them: IDF-weighted lexical coverage, i.e. how
# much of the question's distinctive vocabulary the chunk contains.
# Answerable min 0.637, refuse max 0.494.
MIN_LEXICAL_COVERAGE=0.55

# --- added in Phase 1 / 2 ---------------------------------------------------
# Chunking. all-MiniLM-L6-v2 truncates at 256 wordpiece tokens, so chunks must
# stay well below that or their tail is silently dropped at embedding time.
CHUNK_SIZE_TOKENS=200
CHUNK_HARD_CAP_TOKENS=240
CHUNK_OVERLAP_TOKENS=25

# Politeness delay between page fetches.
REQUEST_DELAY_SECONDS=1.5
